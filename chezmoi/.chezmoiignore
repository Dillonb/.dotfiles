.oh-my-zsh/cache
{{- if eq .chezmoi.os "windows" }}
# On Windows, ignore all Unix-style hidden files
.*
*.sh
# .config has another .chezmoiignore inside it
!.config
# Applies to windows only
!.razzle
# psmux reads ~/.tmux.conf and keeps its plugins in ~/.psmux
!.tmux.conf
!.psmux
{{- else }}
# Non-Windows OS (Linux/Mac)
AppData
*.ps1
*komorebi*
applications.json
.razzle
# psmux is Windows only
.psmux
{{- end }}
